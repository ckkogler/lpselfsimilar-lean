module

public import LpSelfSimilar.Gaussian.BinaryChannelLaw
public import LpSelfSimilar.Bernoulli.Digits
public import Mathlib.Probability.Independence.Basic
public import Mathlib.MeasureTheory.Integral.Prod

@[expose] public section

/-!
# A concrete fair-sign and Gaussian probability space

The sample space is a fair Boolean digit times an independent standard Gaussian.
The observation is u times the existing Bernoulli sign plus that noise. Its
pushforward is exactly the established binary Gaussian output law. The sigma-
algebra used for conditioning is precisely the one generated by this observation.
-/

open MeasureTheory MeasureTheory.Measure ProbabilityTheory

namespace LpSelfSimilar.Gaussian

/-- The product law of a fair digit and standard Gaussian noise. -/
noncomputable def binaryGaussianInput : Measure (Bool × ℝ) :=
  (PMF.uniformOfFintype Bool).toMeasure.prod (gaussianReal 0 1)

instance binaryGaussianInput_isProbabilityMeasure : IsProbabilityMeasure binaryGaussianInput := by
  unfold binaryGaussianInput
  infer_instance

/-- The fair sign on the concrete product probability space. -/
def binaryInputSign (z : Bool × ℝ) : ℝ := Bernoulli.sign z.1

/-- Observing the scaled fair sign in independent standard Gaussian noise. -/
def binaryGaussianOutput (u : ℝ) (z : Bool × ℝ) : ℝ := u * binaryInputSign z + z.2

/-- Exactly the sigma-algebra generated by the observed noisy sign. -/
abbrev binaryGaussianObservation (u : ℝ) : MeasurableSpace (Bool × ℝ) :=
  (borel ℝ).comap (binaryGaussianOutput u)

@[fun_prop] theorem measurable_binaryInputSign : Measurable binaryInputSign :=
  (measurable_of_countable Bernoulli.sign).comp measurable_fst

/-- A fair sign has square exactly one, pointwise. -/
theorem binaryInputSign_sq (z : Bool × ℝ) : binaryInputSign z ^ 2 = 1 := by
  rcases z with ⟨b, x⟩
  cases b <;> norm_num [binaryInputSign, Bernoulli.sign]

@[fun_prop] theorem measurable_binaryGaussianOutput (u : ℝ) :
    Measurable (binaryGaussianOutput u) :=
  (measurable_binaryInputSign.const_mul u).add measurable_snd

/-- Conditioning on the observation uses a genuine sub-sigma-algebra. -/
theorem binaryGaussianObservation_le (u : ℝ) :
    binaryGaussianObservation u ≤ (inferInstance : MeasurableSpace (Bool × ℝ)) :=
  (measurable_binaryGaussianOutput u).comap_le

/-- The noise coordinate has exactly standard Gaussian law. -/
theorem binaryGaussianInput_map_noise :
    binaryGaussianInput.map Prod.snd = gaussianReal 0 1 := by
  simp only [binaryGaussianInput, map_snd_prod, measure_univ, one_smul]

/-- The sign coordinate has exactly the pushforward of a fair binary digit. -/
theorem binaryGaussianInput_map_sign :
    binaryGaussianInput.map binaryInputSign =
      (PMF.uniformOfFintype Bool).toMeasure.map Bernoulli.sign := by
  change binaryGaussianInput.map (Bernoulli.sign ∘ Prod.fst) = _
  rw [← map_map (measurable_of_countable _) measurable_fst]
  simp [binaryGaussianInput]

/-- The fair sign and standard Gaussian noise are independent on the concrete space. -/
theorem binaryInputSign_indep_noise :
    IndepFun binaryInputSign Prod.snd binaryGaussianInput :=
  indepFun_prod (measurable_of_countable Bernoulli.sign) measurable_id

/-- The observation pushforward is the previously defined binary Gaussian law. -/
theorem binaryGaussianInput_map_output (u : ℝ) :
    binaryGaussianInput.map (binaryGaussianOutput u) = binaryGaussianLaw u := by
  have hm : (PMF.uniformOfFintype Bool).toMeasure.map (fun b => u * Bernoulli.sign b) =
      (PMF.uniformOfFintype Bool).toMeasure.map (fun b => if b then u else -u) := by
    congr 1
    funext b
    cases b <;> simp [Bernoulli.sign]
  have hp := map_prod_map (PMF.uniformOfFintype Bool).toMeasure (gaussianReal 0 1)
    (measurable_of_countable (fun b => u * Bernoulli.sign b)) measurable_id
  simp only [map_id] at hp
  rw [binaryGaussianLaw, ← hm, Measure.conv, hp,
    map_map (by fun_prop) ((measurable_of_countable _).prodMap measurable_id)]
  rfl

/-- The sign lies in every Lp space, including L2 needed by conditional variance. -/
theorem memLp_binaryInputSign (p : ENNReal) : MemLp binaryInputSign p binaryGaussianInput := by
  apply MemLp.of_bound measurable_binaryInputSign.aestronglyMeasurable 1
  exact ae_of_all _ (fun z => by simp [binaryInputSign])

/-- The concrete sign is integrable. -/
theorem integrable_binaryInputSign : Integrable binaryInputSign binaryGaussianInput :=
  (memLp_binaryInputSign 1).integrable (by norm_num)

end LpSelfSimilar.Gaussian
