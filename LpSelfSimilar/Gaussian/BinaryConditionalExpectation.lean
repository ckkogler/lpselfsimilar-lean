module

public import LpSelfSimilar.Gaussian.BinaryPosteriorTesting
public import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic

@[expose] public section

/-!
# The actual binary Gaussian conditional expectation

The observation sigma-algebra is the comap generated by the actual noisy sign.
The hyperbolic tangent is measurable for that sigma-algebra, integrable, and has
the same integral as the sign on every observation event. Conditional-expectation
uniqueness therefore identifies the actual Mathlib operator, with all finiteness
and sub-sigma-algebra conditions discharged on the concrete probability space.
-/

open MeasureTheory MeasureTheory.Measure ProbabilityTheory Real Set

namespace LpSelfSimilar.Gaussian

/-- The posterior mean is measurable for the sigma-algebra generated by the observation. -/
theorem measurable_binaryPosteriorMean_observation (u : ℝ) :
    Measurable[binaryGaussianObservation u]
      (fun z => tanh (u * binaryGaussianOutput u z)) := by
  have ht : Measurable (fun x : ℝ => tanh (u * x)) := by
    simpa only [add_zero] using (continuous_tanh_affine u 0).measurable
  exact ht.comp (comap_measurable (binaryGaussianOutput u))

/-- The concrete posterior mean has a finite expectation. -/
theorem integrable_binaryPosteriorMean (u : ℝ) :
    Integrable (fun z => tanh (u * binaryGaussianOutput u z)) binaryGaussianInput := by
  have h := integrable_tanh_affine (binaryGaussianLaw u) u 0
  simp only [add_zero] at h
  rw [← binaryGaussianInput_map_output u] at h
  exact h.comp_measurable (measurable_binaryGaussianOutput u)

/-- Equality of sign and posterior integrals on every Borel observation event. -/
theorem setIntegral_binaryInputSign_eq_posterior (u : ℝ) {s : Set ℝ} (hs : MeasurableSet s) :
    (∫ z in binaryGaussianOutput u ⁻¹' s, binaryInputSign z ∂binaryGaussianInput) =
      ∫ z in binaryGaussianOutput u ⁻¹' s, tanh (u * binaryGaussianOutput u z)
        ∂binaryGaussianInput := by
  have h := integral_binaryInputSign_mul_output_eq_tanh u
    (f := s.indicator (fun _ : ℝ => (1 : ℝ))) (measurable_const.indicator hs)
    ((integrable_const _).indicator hs) ((integrable_const _).indicator hs)
  have hpre := (measurable_binaryGaussianOutput u) hs
  rw [← integral_indicator hpre, ← integral_indicator hpre]
  convert h using 1
  · congr 1
    funext z
    by_cases hz : binaryGaussianOutput u z ∈ s <;> simp [hz]
  · congr 1
    funext z
    by_cases hz : binaryGaussianOutput u z ∈ s <;> simp [hz]

/-- The actual conditional expectation of the fair sign is the hyperbolic tangent posterior. -/
theorem condExp_binaryInputSign (u : ℝ) :
    binaryGaussianInput[binaryInputSign | binaryGaussianObservation u] =ᵐ[binaryGaussianInput]
      fun z => tanh (u * binaryGaussianOutput u z) := by
  apply (ae_eq_condExp_of_forall_setIntegral_eq (binaryGaussianObservation_le u)
    integrable_binaryInputSign
    (fun s _ _ => (integrable_binaryPosteriorMean u).integrableOn) ?_
    (measurable_binaryPosteriorMean_observation u).stronglyMeasurable.aestronglyMeasurable).symm
  intro s hs _
  rcases MeasurableSpace.measurableSet_comap.mp hs with ⟨t, ht, rfl⟩
  exact (setIntegral_binaryInputSign_eq_posterior u ht).symm

end LpSelfSimilar.Gaussian
