module

public import LpSelfSimilar.Algebraic.MinimalPolynomial
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.FieldTheory.IntermediateField.Algebraic

@[expose] public section

/-!
Canonical algebraic degrees under positive powers.

The field generated by x^k is a subfield of the field generated by x, giving
divisibility and the upper degree bound. Conversely, composing the minimal
polynomial of x^k with X^k yields a polynomial vanishing at x, giving
degree(x) <= k*degree(x^k). These statements use the actual minimal-polynomial
degree and are the degree component of the paper's power-selection argument.
-/

open Polynomial IntermediateField

namespace LpSelfSimilar.Algebraic

lemma isAlgebraic_pow {x : ℝ} (hx : IsAlgebraic ℚ x) (k : ℕ) :
    IsAlgebraic ℚ (x ^ k) := (hx.isIntegral.pow k).isAlgebraic

lemma adjoin_pow_le (x : ℝ) (k : ℕ) : ℚ⟮x ^ k⟯ ≤ ℚ⟮x⟯ := by
  apply adjoin_le_iff.mpr
  intro y hy
  have he : y = x ^ k := Set.mem_singleton_iff.mp hy
  rw [he]
  exact (ℚ⟮x⟯).pow_mem (mem_adjoin_simple_self ℚ x) k

/-- The degree of a power divides the original degree, by the actual field tower. -/
theorem algebraicDegree_pow_dvd {x : ℝ} (hx : IsAlgebraic ℚ x) (k : ℕ) :
    algebraicDegree (x ^ k) ∣ algebraicDegree x := by
  have h := finrank_dvd_of_le_right (adjoin_pow_le x k)
  rwa [adjoin.finrank (isAlgebraic_pow hx k).isIntegral,
    adjoin.finrank hx.isIntegral] at h

theorem algebraicDegree_pow_le {x : ℝ} (hx : IsAlgebraic ℚ x) (k : ℕ) :
    algebraicDegree (x ^ k) ≤ algebraicDegree x :=
  Nat.le_of_dvd (algebraicDegree_pos hx) (algebraicDegree_pow_dvd hx k)

/-- The lower degree bound written without a division or rounding convention. -/
theorem algebraicDegree_le_mul_pow {x : ℝ} (hx : IsAlgebraic ℚ x)
    {k : ℕ} (hk : 1 ≤ k) : algebraicDegree x ≤ k * algebraicDegree (x ^ k) := by
  let p := minpoly ℚ (x ^ k)
  have hp : p.Monic := minpoly.monic (isAlgebraic_pow hx k).isIntegral
  have hroot : aeval x (p.comp (X ^ k)) = 0 := by
    rw [aeval_comp, map_pow, aeval_X]
    exact minpoly.aeval ℚ (x ^ k)
  have hnonzero : p.comp (X ^ k) ≠ 0 := by
    exact (hp.comp (monic_X_pow k) (by simpa using (show k ≠ 0 by omega))).ne_zero
  have hd := natDegree_le_of_dvd (minpoly.dvd ℚ x hroot) hnonzero
  rw [natDegree_comp, natDegree_X_pow] at hd
  simpa only [algebraicDegree, mul_comm] using hd

end LpSelfSimilar.Algebraic
