module

public import LpSelfSimilar.Probability.ParameterizedConditionalVariance
public import LpSelfSimilar.Entropy.EntropyVariance
public import Mathlib.Probability.Independence.Basic

@[expose] public section

/-!
The paper's actual random-shift observation and its normalized conditional
variance. The finite averaged grid formula is identified with Mathlib `condVar`,
first on the canonical product space and then for any independent realization.
This gives Lemma 3.5 with the exact constant ten and real exponent one quarter.
-/

open MeasureTheory ProbabilityTheory Set Real

namespace LpSelfSimilar.Entropy

/-- The uniform probability measure used to shift a unit grid. -/
noncomputable def uniformGridShift : Measure ℝ := volume.restrict (Icc (0 : ℝ) 1)

instance : IsProbabilityMeasure uniformGridShift := ⟨by simp [uniformGridShift]⟩

/-- The recorded shift and grid cell; the second coordinate of the input is X. -/
noncomputable def gridObservation (s : ℝ) (z : ℝ × ℝ) : ℝ × ℤ :=
  (z.1, quantize s z.1 z.2)

@[fun_prop] lemma measurable_gridObservation (s : ℝ) : Measurable (gridObservation s) := by
  unfold gridObservation quantize
  fun_prop

/-- The sigma-algebra generated by the pair (T, floor(X/s+T)). -/
@[instance_reducible]
noncomputable def gridObservationSigma (s : ℝ) : MeasurableSpace (ℝ × ℝ) :=
  (inferInstance : MeasurableSpace (ℝ × ℤ)).comap (gridObservation s)

/-- The finite formula is exactly normalized expected canonical conditional variance. -/
theorem scaleVariance_eq_expected_condVar (p : PMF ℝ) (hp : p.support.Finite) (s : ℝ) :
    scaleVariance p hp s =
      (∫ z, condVar (gridObservationSigma s) (fun z : ℝ × ℝ ↦ z.2)
        (uniformGridShift.prod p.toMeasure) z ∂uniformGridShift.prod p.toMeasure) / s ^ 2 := by
  have hf : Measurable (fun z : ℝ × ℝ ↦ quantize s z.1 z.2) := by
    unfold quantize
    fun_prop
  have h := integral_condVar_parameterized_finite uniformGridShift p hp _ hf
  change scaleVariance p hp s = _ / s ^ 2
  rw [show (∫ z, condVar (gridObservationSigma s) (fun z : ℝ × ℝ ↦ z.2)
      (uniformGridShift.prod p.toMeasure) z ∂uniformGridShift.prod p.toMeasure) =
      ∫ t, FiniteProbability.meanConditionalVariance p hp (quantize s t) id
        ∂uniformGridShift from h]
  exact integral_div _ _

/-- Any independent uniform shift realizes the same normalized conditional variance. -/
theorem scaleVariance_eq_expected_condVar_of_independent {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} [IsProbabilityMeasure P] {X T : Ω → ℝ}
    (hX : Measurable X) (hT : Measurable T) (hind : IndepFun T X P)
    (hTlaw : P.map T = uniformGridShift) (p : PMF ℝ) (hp : p.support.Finite)
    (hXlaw : P.map X = p.toMeasure) (s : ℝ) :
    scaleVariance p hp s =
      (∫ ω, condVar ((inferInstance : MeasurableSpace (ℝ × ℤ)).comap
        (fun ω ↦ (T ω, quantize s (T ω) (X ω)))) X P ω ∂P) / s ^ 2 := by
  have hZ : Measurable (fun ω ↦ (T ω, X ω)) := hT.prodMk hX
  have hZlaw : P.map (fun ω ↦ (T ω, X ω)) = uniformGridShift.prod p.toMeasure := by
    rw [hind.map_prod_eq_prod_map_map hT.aemeasurable hX.aemeasurable, hTlaw, hXlaw]
  have hi : MemLp (fun x : ℝ ↦ x) 2 p.toMeasure :=
    (memLp_two_iff_integrable_sq (by fun_prop)).2
      (FiniteProbability.integrable_of_finite_support p hp (fun x ↦ x ^ 2))
  have hF : MemLp (fun z : ℝ × ℝ ↦ z.2) 2 (P.map (fun ω ↦ (T ω, X ω))) := by
    rw [hZlaw]
    exact hi.comp_measurePreserving measurePreserving_snd
  have he := integral_condVar_map hZ (measurable_gridObservation s) hF
  rw [hZlaw] at he
  rw [scaleVariance_eq_expected_condVar]
  exact congrArg (fun v ↦ v / s ^ 2) he

/-- Lemma 3.5, using the paper's actual conditional variance and real exponent 1/4. -/
theorem gridEntropy_increment_le_ten_condVar_fourthRoot {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} [IsProbabilityMeasure P] {X T : Ω → ℝ}
    (hX : Measurable X) (hT : Measurable T) (hind : IndepFun T X P)
    (hTlaw : P.map T = uniformGridShift) (p : PMF ℝ) (hp : p.support.Finite)
    (hXlaw : P.map X = p.toMeasure) {s : ℝ} (hs : 0 < s) :
    gridEntropy p hp (s / 4) - gridEntropy p hp s ≤
      10 * ((∫ ω, condVar ((inferInstance : MeasurableSpace (ℝ × ℤ)).comap
        (fun ω ↦ (T ω, quantize s (T ω) (X ω)))) X P ω ∂P) / s ^ 2) ^ (1 / 4 : ℝ) := by
  have he : sqrt (sqrt (scaleVariance p hp s)) = scaleVariance p hp s ^ (1 / 4 : ℝ) := by
    rw [sqrt_eq_rpow, sqrt_eq_rpow, ← rpow_mul (scaleVariance_nonneg p hp s)]
    norm_num
  have h := gridEntropy_increment_le_ten_fourthRoot_scaleVariance p hp hs
  rw [he, scaleVariance_eq_expected_condVar_of_independent hX hT hind hTlaw p hp hXlaw s] at h
  exact h

end LpSelfSimilar.Entropy
